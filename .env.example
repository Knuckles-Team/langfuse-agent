# ==============================================================================
# Langfuse Agent Environment Configuration
# ==============================================================================

# --- MCP Server Settings ---
HOST=127.0.0.1
PORT=8004
TRANSPORT=stdio # options: stdio, streamable-http, sse

# --- Telemetry & Observability (OTEL / Langfuse) ---
ENABLE_OTEL=False
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.invalid
# OTEL_EXPORTER_OTLP_PUBLIC_KEY_REF=
# OTEL_EXPORTER_OTLP_SECRET_KEY_REF=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Enterprise Security & Access Governance (Eunomia) ---
EUNOMIA_TYPE=none # options: none, embedded, remote
EUNOMIA_POLICY_FILE=mcp_policies.json
# EUNOMIA_REMOTE_URL=http://eunomia-server:8000

# --- Langfuse parent configuration (references are resolved at runtime) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY_REF=
LANGFUSE_SECRET_KEY_REF=
# LANGFUSE_TLS_PROFILE_REF=
# LANGFUSE_CA_BUNDLE_REF=
# LANGFUSE_CLIENT_CERT_REF=
# LANGFUSE_CLIENT_KEY_REF=
# LANGFUSE_CLIENT_KEY_PASSWORD_REF=
# Required only when LANGFUSE_KG_AUTO_INGEST=True.
# LANGFUSE_PERSISTENCE_HMAC_KEY_REF=

# --- Authentication Mode ---
AUTH_TYPE=key # options: key, delegated, none

# --- Agent Profile & Behavior ---
DEFAULT_AGENT_NAME="Langfuse Agent"
AGENT_DESCRIPTION="AI agent for Langfuse Agent operations."
AGENT_SYSTEM_PROMPT=""

# --- Tool Surface ---
# MCP_TOOL_MODE selects intent (default), condensed, verbose, or both surfaces.
MCP_TOOL_MODE=intent

# --- Tool Toggle Switches (per-domain <DOMAIN>TOOL; set False to disable) ---
# These names match the authoritative "Toggle Env Var" column in the README
# MCP tools table (condensed action-routed surface).
LANGFUSE_OBSERVABILITYTOOL=True
LANGFUSE_DATASETSTOOL=True
LANGFUSE_PROMPTS_MODELSTOOL=True
LANGFUSE_MANAGEMENTTOOL=True
LANGFUSE_KGTOOL=True
